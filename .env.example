# ==============================================================================
# QWAP DEX AUTOMATION BOT CONFIGURATION (.env)
# Network: QMS Testnet (Chain ID: 19480)
# ==============================================================================

# QMS Testnet JSON-RPC endpoint
RPC_URL=https://rpc.testnet.qms.finance

# Private Key(s): Single key, or comma-separated for multi-wallet rotation
# (e.g. 0xabc...,0xdef...)
# You can also list them line-by-line in wallets.txt
PRIVATE_KEYS=your_private_key_here

# ------------------------------------------------------------------------------
# GENERAL BOT SETTINGS
# ------------------------------------------------------------------------------
SLIPPAGE_TOLERANCE=2.5          # Max slippage tolerance in percent (2.5 = 2.5%, recommended for testnet)
DEADLINE_MINUTES=20             # Transaction deadline from current time (minutes)
MIN_GAS_RESERVE=0.05            # Minimum native QMS to reserve so wallet never runs out of gas
MIN_DELAY_SECONDS=10            # Minimum sleep delay between transactions (seconds)
MAX_DELAY_SECONDS=25            # Maximum sleep delay between transactions (seconds)
CYCLES=15                       # Default number of execution cycles (applies to both if unset)
SWAP_CYCLES=15                  # (Optional) Specific number of cycles for swaps
LIQUIDITY_CYCLES=15             # (Optional) Specific number of cycles for adding liquidity

# ------------------------------------------------------------------------------
# AUTO SWAP ADJUSTMENTS
# ------------------------------------------------------------------------------
MIN_SWAP_AMOUNT=0.01            # Minimum amount of base token to swap per cycle
MAX_SWAP_AMOUNT=0.10            # Maximum amount of base token to swap per cycle

# ------------------------------------------------------------------------------
# AUTO LIQUIDITY ADJUSTMENTS
# ------------------------------------------------------------------------------
# Amount of Token A (e.g. QMS) to allocate when adding liquidity.
# Note: The paired Token B amount is calculated automatically via the AMM reserve
# ratio (router.quote) to guarantee transactions don't fail due to unbalanced ratios.
MIN_LIQUIDITY_AMOUNT=0.01       # Minimum base token amount to supply as liquidity
MAX_LIQUIDITY_AMOUNT=0.05       # Maximum base token amount to supply as liquidity

# Target pool pairs to rotate liquidity across (comma-separated)
# Available: QMS-USDC, QMS-USDT, QMS-WETH, QMS-WBTC, USDC-USDT, WETH-USDC
TARGET_POOLS=QMS-USDC,QMS-USDT,QMS-WETH

# Optional LP Lifecycle Management:
# Automatically remove liquidity periodically to test full LP lifecycle
AUTO_REMOVE_LIQUIDITY=false     # Set to true to periodically remove LP tokens
REMOVE_LIQUIDITY_PERCENT=50     # Percentage of LP tokens to remove (1-100%)

# ------------------------------------------------------------------------------
# DAILY RANDOM SCHEDULER SETTINGS (e.g. 1-5 UTC)
# ------------------------------------------------------------------------------
# Target window in UTC hours for automated daily execution
DAILY_START_HOUR_UTC=1          # Start of daily execution window (e.g. 1 = 01:00 UTC)
DAILY_END_HOUR_UTC=5            # End of daily execution window (e.g. 5 = 05:00 UTC)
RUN_IMMEDIATELY_ON_START=true   # If true, runs one full cycle right when launched, then waits for next window

